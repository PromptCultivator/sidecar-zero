# Type stubs for the native core (sdks/python/src). mypy and pyright read these: a Client
# built without `fallback`, or with one of the wrong type, is rejected before it runs.

from os import PathLike
from typing import Any, Callable, Generic, Optional, Sequence, TypeVar, Union

from ._enums import FallbackReason, Source

_In = TypeVar("_In")
_Out = TypeVar("_Out")

LINUX: bool
VERSION: str
REASONS: list[str]

class Unwound(RuntimeError): ...

class Outcome(Generic[_Out]):
    def __init__(self, value: _Out, source: Source, reason: Optional[FallbackReason] = None, model_gen: int = 0) -> None: ...
    @property
    def value(self) -> _Out: ...
    @property
    def source(self) -> Source: ...
    @property
    def reason(self) -> Optional[FallbackReason]: ...
    @property
    def model_gen(self) -> int: ...
    @property
    def is_model(self) -> bool: ...

class Bytes:
    def __init__(self, *, response_len: Optional[int] = None) -> None: ...
    @property
    def response_len(self) -> Optional[int]: ...
    def schema_fingerprint(self) -> None: ...
    def _set_fault(self, mode: str) -> None: ...
    def _prepare(self, input: Any) -> Optional[bytes]: ...
    def _decode(self, response: Any) -> Optional[bytes]: ...

class DenseF32ToScore:
    def __init__(self, n: int, *, input: str = "features", output: str = "score", strict: bool = False) -> None: ...
    @property
    def n(self) -> int: ...
    @property
    def strict(self) -> bool: ...
    def schema_fingerprint(self) -> int: ...
    def _set_fault(self, mode: str) -> None: ...
    def _prepare(self, input: Any) -> Optional[tuple[bytes, int, bool]]: ...
    def _decode(self, scores: Sequence[float], rows: int, scalar: bool) -> Any: ...

class NativeFallback:
    def _check(self, codec: Union[Bytes, DenseF32ToScore]) -> None: ...
    def _apply(self, codec: Union[Bytes, DenseF32ToScore], input: Any) -> Any: ...

def constant(value: Any) -> NativeFallback: ...
def threshold(*, feature: int, gt: float, then: float, otherwise: float) -> NativeFallback: ...
def linear(*, weights: Sequence[float], bias: float = 0.0, link: str = "identity") -> NativeFallback: ...
def lookup(*, feature: int, table: Sequence[float], otherwise: float) -> NativeFallback: ...
def fingerprint(request: Sequence[tuple[str, int, int, bool]], response: Sequence[tuple[str, int, int, bool]]) -> int: ...
def monotonic_ns() -> int: ...
def _arm_unwind() -> bool: ...

class Client(Generic[_In, _Out]):
    def __init__(
        self,
        endpoint: Union[str, PathLike[str]],
        *,
        codec: Union[Bytes, DenseF32ToScore],
        fallback: Union[Callable[[_In, FallbackReason], _Out], NativeFallback],
        fallback_reserve_ms: float = 0.0,
        connect_timeout_ms: float = 1000.0,
        callers: int = 256,
        spin_ceiling_ms: Optional[float] = None,
        on_fallback: Optional[Callable[[FallbackReason], object]] = None,
        sample_every: int = 64,
    ) -> None: ...
    def infer(self, input: _In, budget_ms: float) -> Outcome[_Out]: ...
    def await_bound(self, timeout: float = 5.0) -> bool: ...
    def set_spin_ceiling(self, ms: Optional[float]) -> None: ...
    @property
    def state(self) -> str: ...
    @property
    def endpoint(self) -> str: ...
    @property
    def closed(self) -> bool: ...
    def stats(self) -> dict[str, Any]: ...
    def export(self, sink: Any) -> None: ...
    def prometheus_text(self) -> str: ...
    def close(self) -> bool: ...
    def __enter__(self) -> "Client[_In, _Out]": ...
    def __exit__(self, *exc: object) -> bool: ...
    def _census(self) -> Optional[list[int]]: ...
