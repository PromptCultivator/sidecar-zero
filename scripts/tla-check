#!/usr/bin/env bash
# Model-check both TLA+ specifications in every configuration (testing §2.1).
#
#   scripts/tla-check            every configuration in spec/
#   scripts/tla-check NAME       only that configuration (spec/NAME.cfg), if it exists;
#                                otherwise those whose name contains NAME
#
# Prints one line per configuration. Exits non-zero if any reports a violation or fails to
# finish. Full TLC output is kept in target/tla/. Needs only Docker.
set -euo pipefail
cd "$(dirname "$0")/.."
mkdir -p target/tla
status=0
for cfg in spec/*.cfg; do
  name=$(basename "$cfg" .cfg)
  case "$name" in .mutant-*) continue ;; esac
  if [ -n "${1:-}" ]; then
    if [ -f "spec/$1.cfg" ]; then [ "$name" = "$1" ] || continue
    else [[ "$name" == *"$1"* ]] || continue; fi
  fi
  spec=spec/${name%%-*}.tla
  log=target/tla/$name.log
  start=$(date +%s)
  if scripts/tlc "$spec" "$cfg" >"$log" 2>&1 && grep -q "No error has been found" "$log"; then
    states=$(grep -o '[0-9,]* distinct states found' "$log" | tail -1 | cut -d' ' -f1)
    printf 'ok      %-28s %14s distinct states  %4ss\n' "$name" "$states" "$(( $(date +%s) - start ))"
  else
    status=1
    why=$(grep -m1 -E 'violated|Error:|Assertion' "$log" || echo "did not finish")
    printf 'FAILED  %-28s %s (log: %s)\n' "$name" "$why" "$log"
  fi
done
exit $status
