#!/usr/bin/env bash
# The upgrade test between adjacent minor versions (shm-abi §12.5). Needs only Docker.
#
#   scripts/upgrade-test                 every SDK
#   scripts/upgrade-test rust go         only these (rust, java-ffm, cpp20, go, python)
#
# Builds this version, and a "next minor" of the sidecar and the Rust SDK (the `next-minor`
# feature of scz-shm: abi_minor + 1, every reserved byte filled, a completion ring appended,
# unknown feature and HELLO bits set), then runs the whole conformance suite twice over:
#
#   old client, new sidecar   each SDK's agent as built from this tree, against the next
#                             minor's supervisor and workers
#   new client, old sidecar   the next minor's Rust agent against this version's sidecar
#
# Non-zero if any scenario or suite check fails. Builds run niced, with CARGO_BUILD_JOBS
# (default 6) jobs.
set -euo pipefail
cd "$(dirname "$0")/.."
SDKS=${*:-rust java-ffm cpp20 go python}
scripts/dev env SDKS="$SDKS" bash -c '
set -euo pipefail
export CARGO_BUILD_JOBS=${CARGO_BUILD_JOBS:-6}
step() { printf "\n== %s\n" "$1"; }
CRASH=scz-worker-core/crashpoints,scz-conformance-agent/crashpoints
step "build: this version, and its crash-point builds"
nice cargo build -q --release --workspace --bins
nice cargo build -q --release --target-dir target/crash -p scz-worker-core -p scz-conformance-agent --features $CRASH --bins
step "build: the next minor, and its crash-point builds"
nice cargo build -q --release --target-dir target/next -p scz-supervisor -p scz-worker-core -p scz-worker-ort \
  -p scz-conformance-agent -p scz-ctl --features scz-shm/next-minor --bins
nice cargo build -q --release --target-dir target/next-crash -p scz-worker-core -p scz-conformance-agent \
  --features $CRASH,scz-shm/next-minor --bins
step "the next minor lays out what shm-abi §12.5 says"
nice cargo test -q --target-dir target/next -p scz-shm --features next-minor next:: 2>&1 | grep -E "test result: ok. [1-9]" \
  || { echo "the next-minor layout test failed"; exit 1; }
# One run of the suite. Prints the skips and the summary; on a failure, everything but the passes.
suite() { # title bins crash-bins agent crash-agent
  step "$1"
  local out
  if ! out=$(target/release/scz-conformance --bins="$2" --crash-bins="$3" --agent="$4" ${5:+--crash-agent="$5"} \
      conformance/scenarios conformance/scenarios/crash 2>&1); then
    printf "%s\n" "$out" | grep -v "^PASS" | tail -120
    return 1
  fi
  printf "%s\n" "$out" | grep -E "^(SKIP|SUITE)|passed, " || true
}
failed=0
abi=$(awk "/^major =/{M=\$3} /^minor =/{m=\$3} END{print M\".\"m}" abi/scz_abi.toml)
for lang in $SDKS; do
  if [ "$lang" = rust ]; then
    agent=target/release/scz-agent-rust crash=target/crash/release/scz-agent-rust
  else
    step "sdk $lang: build"
    out=$(sdks/$lang/build.sh 2>&1) || { printf "%s\n" "$out" | tail -40; exit 1; }
    agent=$(ls target/sdk/$lang/scz-agent-* | head -1)
    crash=$(ls target/sdk/$lang/crash/scz-agent-* 2>/dev/null | head -1 || true)
  fi
  suite "old client ($lang, ABI $abi), new sidecar (next minor)" \
    target/next/release target/next-crash/release "$agent" "$crash" || failed=1
done
suite "new client (rust, next minor), old sidecar" \
  target/release target/crash/release target/next/release/scz-agent-rust target/next-crash/release/scz-agent-rust || failed=1
exit $failed
'
